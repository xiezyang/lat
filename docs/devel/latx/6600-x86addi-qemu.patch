+
+/* Signed-byte ADD flag operations leave the input register unchanged. */
+static bool trans_x86addi_w(DisasContext *ctx, arg_x86addi_w *a)
+{
+    if (!ctx->bt_6600 || !avail_64(ctx)) {
+        return false;
+    }
+    CHECK_BTE;
+    TCGv src = gpr_src(ctx, a->rd, EXT_NONE);
+    gen_helper_lbt_x86add_w(tcg_env, src, tcg_constant_tl(a->imm));
+    return true;
+}
+
+static bool trans_x86addi_d(DisasContext *ctx, arg_x86addi_d *a)
+{
+    if (!ctx->bt_6600 || !avail_64(ctx)) {
+        return false;
+    }
+    CHECK_BTE;
+    TCGv src = gpr_src(ctx, a->rd, EXT_NONE);
+    gen_helper_lbt_x86add_d(tcg_env, src, tcg_constant_tl(a->imm));
+    return true;
 }
