+/* FLD follows the same optional x87 stack mapping as scalar FPR writes. */
+void helper_fld_clear(CPULoongArchState *env, uint64_t val, uint32_t reg_num)
+{
+    if (reg_num < 8 && (env->fcsr0 & (1 << 6))) {
+        reg_num = (reg_num + env->x86_top) % 8;
+    }
+    env->fpr[reg_num].vreg.D[0] = val;
+    env->fpr[reg_num].vreg.D[1] = 0;
+}
